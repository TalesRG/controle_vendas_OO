<+>package controller.respository;\r\n\r\nimport model.Cliente;\r\nimport model.PessoaFisica;\r\nimport model.PessoaJuridica;\r\n\r\nimport java.util.*;\r\nimport java.util.stream.Collectors;\r\n\r\npublic class ClienteListRepository implements ClienteRepository {\r\n\r\n    private  static List<Cliente> storage = new ArrayList<>();\r\n\r\n    private static int idAtual = 1;\r\n\r\n    @Override\r\n    public void salvar(Cliente cliente) {\r\n\r\n        cliente.setId(String.valueOf(idAtual));\r\n        storage.add(cliente);\r\n\r\n        idAtual++;\r\n    }\r\n\r\n    @Override\r\n    public Optional<Cliente> pesquisarPorId(String idPesquisado) {\r\n\r\n        /*for (Cliente cliente : storage) {\r\n            if(cliente.getId().equals(idPesquisado)){\r\n                return Optional.of(cliente);\r\n            }\r\n        }\r\n        return Optional.empty();*/\r\n\r\n        return storage\r\n                .stream()\r\n                .filter(clienteArmazenado -> clienteArmazenado.getId().equals(idPesquisado))\r\n                .findFirst();\r\n    }\r\n\r\n    public List<PessoaFisica> pesquisarPessoasFisicas() {\r\n        return storage\r\n                .stream()\r\n                .filter(clienteArmazenado -> clienteArmazenado.isPessoaFisica())\r\n                .map(clienteFiltrado -> (PessoaFisica) clienteFiltrado)\r\n                .collect(Collectors.toList());\r\n    }\r\n\r\n    public List<PessoaJuridica> pesquisarPessoasJuridicas() {\r\n        return storage\r\n                .stream()\r\n                .filter(clienteArmazenado -> clienteArmazenado.isPessoaJuridica())\r\n                .map(clienteFiltrado -> (PessoaJuridica) clienteFiltrado)\r\n                .collect(Collectors.toList());\r\n    }\r\n\r\n    public List<Cliente> pesquisarClientes() {\r\n        return storage;\r\n    }\r\n\r\n    public void deletar(String idDeletar) {\r\n        storage\r\n                .removeIf(clienteArmazenado -> clienteArmazenado.getId().equals(idDeletar));\r\n    }\r\n\r\n\r\n}\r\n
