<+>package view;\r\n\r\nimport controller.service.ClienteService;\r\nimport controller.service.PedidoService;\r\nimport controller.service.ProdutoService;\r\n\r\nimport javax.swing.*;\r\nimport java.awt.*;\r\nimport java.awt.event.ActionEvent;\r\nimport java.util.Optional;\r\n\r\npublic class SubMenu extends Componentes {\r\n    private static JButton cadastro_cliente = new JButton(\"Cadastrar Pessoa Fisica\");\r\n    private static JButton cadastro_cliente_PJ = new JButton(\"Cadastrar Pessoa Juridica\");\r\n    private static JButton cadastro_produto = new JButton(\"Cadastrar produto\");\r\n    private static JButton cadastro_pedido = new JButton(\"Cadastrar pedido\");\r\n\r\n    private static JButton vizualizarClientePF = new JButton(\"Listar Pessoa Fisica\");\r\n    private static JButton vizualizarClientePJ = new JButton(\"Listar Pessoa Juridica\");\r\n    private static JButton vizualizarProduto = new JButton(\"Listar Produtos\");\r\n\r\n    private static JButton excluirCliente;\r\n    private static JButton excluirProduto;\r\n\r\n    private static JButton buscarCliente;\r\n    private static JButton buscarProduto;\r\n    private JLabel titulo = new JLabel();\r\n    private final ClienteService clienteService;\r\n    private final PedidoService pedidoService;\r\n    private final ProdutoService produtoService;\r\n\r\n    public SubMenu(int opcao) {\r\n        clienteService = new ClienteService();\r\n        produtoService = new ProdutoService();\r\n        pedidoService = new PedidoService();\r\n\r\n        switch (opcao) {\r\n            case 1:\r\n                //Botoes cliente\r\n                titulo = new JLabel(\"Clientes\");\r\n                titulo.setFont(new Font(\"Arial\", Font.BOLD, 20));\r\n                titulo.setBounds(200, 10, 200, 30);\r\n                add(titulo);\r\n\r\n                //vizualizar ClientesPF\r\n                vizualizarClientePF.setBounds(30, 80, 180, 20);\r\n                add(vizualizarClientePF);\r\n                vizualizarClientePF.addActionListener(this::vizualizar);\r\n\r\n                //vizualizar ClientesPJ\r\n                vizualizarClientePJ.setBounds(250, 80, 180, 20);\r\n                add(vizualizarClientePJ);\r\n                vizualizarClientePJ.addActionListener(this::vizualizar);\r\n\r\n                //cadastrar cliente\r\n                cadastro_cliente.setBounds(30, 50, 180, 20);\r\n                add(cadastro_cliente);\r\n                cadastro_cliente.addActionListener(this::cadastrar);\r\n\r\n                //cadastrar cliente Pessoa Juridica\r\n                cadastro_cliente_PJ.setBounds(250, 50, 180, 20);\r\n                add(cadastro_cliente_PJ);\r\n                cadastro_cliente_PJ.addActionListener(this::cadastrar);\r\n                //excluir\r\n                excluirCliente = new JButton(\"Excluir cliente\");\r\n                excluirCliente.setBounds(250, 110, 180, 20);\r\n                add(excluirCliente);\r\n                excluirCliente.addActionListener(this::excluir);\r\n                //buscar cliente\r\n                buscarCliente = new JButton(\"Buscar\");\r\n                buscarCliente.setBounds(30, 110, 180, 20);\r\n                add(buscarCliente);\r\n                buscarCliente.addActionListener(this::buscar);\r\n                break;\r\n            case 2:\r\n                titulo = new JLabel(\"Produtos\");\r\n                titulo.setFont(new Font(\"Arial\", Font.BOLD, 20));\r\n                titulo.setBounds(200, 10, 200, 30);\r\n                add(titulo);\r\n\r\n                vizualizarProduto.setBounds(30, 80, 180, 20);\r\n                add(vizualizarProduto);\r\n                vizualizarProduto.addActionListener(this::vizualizar);\r\n                cadastro_produto.setBounds(30, 50, 180, 20);\r\n                add(cadastro_produto);\r\n                cadastro_produto.addActionListener(this::cadastrar);\r\n\r\n                excluirProduto = new JButton(\"Excluir produto\");\r\n                excluirProduto.setBounds(250, 80, 180, 20);\r\n                add(excluirProduto);\r\n                excluirProduto.addActionListener(this::excluir);\r\n\r\n                //Buscar\r\n                buscarProduto = new JButton(\"Buscar\");\r\n                buscarProduto.setBounds(250, 50, 180, 20);\r\n                add(buscarProduto);\r\n                buscarProduto.addActionListener(this::buscar);\r\n                break;\r\n\r\n            case 3:\r\n                titulo = new JLabel(\"Pedidos\");\r\n                titulo.setFont(new Font(\"Arial\", Font.BOLD, 20));\r\n                titulo.setBounds(200, 10, 200, 30);\r\n                add(titulo);\r\n\r\n                cadastro_pedido.setBounds(30, 50, 180, 20);\r\n                add(cadastro_pedido);\r\n                cadastro_pedido.addActionListener(this::cadastrar);\r\n                break;\r\n        }\r\n\r\n        setLayout(null);\r\n        setVisible(true);\r\n        setSize(500, 190);\r\n    }\r\n\r\n    //Buscar\r\n    private void buscar(ActionEvent actionEvent) {\r\n        Object buscarSelecionada = actionEvent.getSource();\r\n\r\n        if (buscarCliente == buscarSelecionada) {\r\n            int idClienteBusca = Integer.parseInt(JOptionPane.showInputDialog(\"Insira o id do cliente que deseja buscar\"));\r\n            var clienteEncontrado = clienteService.retornarPorId(idClienteBusca);\r\n\r\n            if (Optional.empty().equals(clienteEncontrado)) {\r\n                JOptionPane.showMessageDialog(this, \"Cliente não encontrado\");\r\n            } else {\r\n                var buscaCliente = clienteEncontrado\r\n                        .stream()\r\n                        .map(c -> c.getNome() + \" - \" + c.getId())\r\n                        .toArray(String[]::new);\r\n\r\n                JOptionPane.showMessageDialog(this, buscaCliente);\r\n            }\r\n        }\r\n        if (buscarProduto == buscarSelecionada) {\r\n            int idProdutoBusca = Integer.parseInt(JOptionPane.showInputDialog(\"Insira o id do produto que deseja buscar\"));\r\n            var produtoEncontrado = produtoService.retornarProdutoPorId(idProdutoBusca);\r\n\r\n            if (Optional.empty().equals(produtoEncontrado)) {\r\n                JOptionPane.showMessageDialog(this, \"Produto não encontrado\");\r\n            } else {\r\n                var buscaProduto = produtoEncontrado\r\n                        .stream()\r\n                        .map(c -> c.getNome() + \" - \" + c.getId())\r\n                        .toArray(String[]::new);\r\n                JOptionPane.showMessageDialog(this, buscaProduto);\r\n            }\r\n        }\r\n\r\n    }\r\n\r\n    //Excluir\r\n    private void excluir(ActionEvent actionEvent) {\r\n        Object excluirSelecionado = actionEvent.getSource();\r\n\r\n        if (excluirCliente == excluirSelecionado) {\r\n            int idCliente = Integer.parseInt(JOptionPane.showInputDialog(\"Insira o id do cliente que deseja excluir\"));\r\n            var clienteEncontrado = clienteService.retornarPorId(idCliente);\r\n            //Se Não retornar nenhum cliente aparece mensagem\r\n            if (Optional.empty().equals(clienteEncontrado)) {\r\n                JOptionPane.showMessageDialog(this, \"Cliente não encontrado\");\r\n            } else {\r\n                clienteService.excluirCliente(String.valueOf(idCliente));\r\n                JOptionPane.showMessageDialog(this, \"Cliente Excluido com sucesso\");\r\n            }\r\n        }\r\n        if (excluirProduto == excluirSelecionado) {\r\n            int idProduto = Integer.parseInt(JOptionPane.showInputDialog(\"Insira o id do produto que deseja excluir\"));\r\n\r\n            var produtoEncontrado = produtoService.retornarProdutoPorId(idProduto);\r\n            //Se Não retornar nenhum produto aparece mensagem\r\n            if (Optional.empty().equals(produtoEncontrado)) {\r\n                JOptionPane.showMessageDialog(this, \"Produto não encontrado\");\r\n            } else {\r\n                produtoService.excluirProduto(String.valueOf(idProduto));\r\n                JOptionPane.showMessageDialog(this, \"produto Excluido com sucesso\");\r\n            }\r\n        }\r\n    }\r\n\r\n    //Cadastrar\r\n    private void cadastrar(ActionEvent actionEvent) {\r\n        Object cadastroSelecionado = actionEvent.getSource();\r\n\r\n        if (cadastro_cliente == cadastroSelecionado) {\r\n            new Cadastro(1);\r\n        }\r\n        if (cadastro_cliente_PJ == cadastroSelecionado) {\r\n            new Cadastro(2);\r\n        }\r\n        if (cadastro_pedido == cadastroSelecionado) {\r\n            new Cadastro(3);\r\n        }\r\n        if (cadastro_produto == cadastroSelecionado) {\r\n            new Cadastro(4);\r\n        }\r\n\r\n    }\r\n\r\n    //Consultar\r\n    private void vizualizar(ActionEvent actionEvent) {\r\n        Object vizualizarSelecionado = actionEvent.getSource();\r\n        //Cria Telas de Listar\r\n        if (vizualizarClientePF == vizualizarSelecionado) {\r\n            new Listar(1);\r\n        }\r\n        if (vizualizarClientePJ == vizualizarSelecionado) {\r\n            new Listar(2);\r\n        }\r\n        if (vizualizarProduto == vizualizarSelecionado) {\r\n            new Listar(3);\r\n        }\r\n        //falta vizualizar pedido\r\n    }\r\n}\r\n
